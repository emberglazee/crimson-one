# --- REQUIRED ---
# Discord Bot Token from the Discord Developer Portal
DISCORD_TOKEN=

# PostgreSQL Database connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crimson_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=crimson_one

# --- AI & API KEYS (Optional, for specific commands) ---
# VoidAI or any other OpenAI-compatible API key for the CrimsonChat module
OPENAI_API_KEY=

# Google API Key with YouTube Data API v3 enabled for the /youtube command
YOUTUBE_API_KEY=

# Steam Web API Key and your Steam64 ID for the /hoi4hours command
STEAM_API_KEY=
STEAM_ID=

# The Movie Database (TMDB) API Key for the /cinematize command
TMDB_API_KEY=


# --- WEBHOOKS & PORTS (Optional) ---
# Port for the web-based dashboard
DASHBOARD_PORT=8080

# Port and secret for the GitHub webhook integration
GITHUB_WEBHOOK_PORT=3000
GITHUB_WEBHOOK_SECRET=

# Port and credentials for the Sleep As Android webhook integration
SLEEP_WEBHOOK_PORT=99603
SLEEP_WEBHOOK_USERNAME=
SLEEP_WEBHOOK_PASSWORD=
